{
  "name": "kraterion",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "stripe:sync": "pnpm --filter @kraterion/control-plane stripe:sync",
    "replay": "pnpm --filter @kraterion/control-plane replay --"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "^5.22.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "4.28.1"
    }
  }
}
