{
  "name": "@kraterion/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "indexer:probe-readmask": "tsx src/indexer/cli/probe-readmask.ts",
    "indexer:reset": "tsx src/indexer/cli/reset-cursor.ts",
    "indexer:fast-forward": "tsx src/indexer/cli/fast-forward.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@kraterion/kraterion-move-sdk": "workspace:*",
    "@kraterion/shared": "workspace:*",
    "@kraterion/walrus-client": "workspace:*",
    "@mysten/sui": "^2.16.2",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@prisma/client": "^5.22.0",
    "@protobuf-ts/grpc-transport": "^2.9.4",
    "@protobuf-ts/runtime-rpc": "^2.9.4",
    "bullmq": "^5.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@types/node": "^20",
    "eslint": "^9",
    "ts-loader": "^9.5.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
