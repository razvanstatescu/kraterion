# Production env inventory for the Kraterion backend (DigitalOcean App
# Platform). This is documentation only — App Platform reads env vars
# from the app spec / dashboard, not from this file. Use it as a
# checklist. Secrets must be set as SECRET-typed vars in DO, never
# committed.
#
# Generate the two crypto secrets with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'

# === Shared by control-plane, gateway, and worker ===
NODE_ENV="production"
TRUST_PROXY="true"
SUI_NETWORK="testnet"
# Managed Postgres + Redis. On App Platform these come from ${db.DATABASE_URL}
# and ${redis.DATABASE_URL}. DO's Postgres URL already includes sslmode=require.
# Optional Prisma pool tuning: append &connection_limit=40&pool_timeout=20.
DATABASE_URL="postgresql://USER:PASS@HOST:25060/db?sslmode=require"
REDIS_URL="rediss://USER:PASS@HOST:25061"
# 32-byte hex. MUST be identical across all three services. Rotating it
# invalidates every wrapped secret in the database.
KEY_WRAPPING_MASTER_KEY=""

# === control-plane only ===
PORT="4001"
SUI_RPC_URL="https://fullnode.testnet.sui.io:443"
JWT_SECRET=""                                   # 32-byte hex
OAUTH_ISSUER="https://api.your-domain.com"      # this service's public URL
GATEWAY_URL="https://s3.your-domain.com"        # gateway public URL
DASHBOARD_ORIGIN="https://app.your-domain.com"  # Vercel dashboard URL
CORS_ORIGINS="https://app.your-domain.com"      # CSV allowlist
ADMIN_EMAILS=""                                 # CSV of admin emails
STRIPE_MODE="test"                              # "test" | "live"
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."               # from the prod webhook endpoint
# Optional — leaving unset disables the feature path:
ENOKI_PRIVATE_KEY=""                            # zkLogin / sponsorship
MEMWAL_ACCOUNT_ID=""                            # agent memory
MEMWAL_DELEGATE_KEY=""
# MEMWAL_SERVER_URL="https://relayer.memwal.ai"

# === gateway only ===
# PORT="4002"
# DASHBOARD_ORIGIN / CORS_ORIGINS as above
KRATERION_POOL_CAPACITY_ENFORCE="true"
KRATERION_SPEND_CAP_ENFORCE="true"

# === worker only ===
# PORT="4003"
SUI_GRPC_HOST="fullnode.testnet.sui.io:443"
# INDEXER_INITIAL_CHECKPOINT="343814677"        # skip history; first checkpoint to scan
# INDEXER_BACKFILL_INTERVAL_MS="100"
# INDEXER_GATEWAY_ADDRESS="0x..."               # filter events by gateway recipient
