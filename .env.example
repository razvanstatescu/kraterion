# Copy to .env at the repo root for local development. The .env file is
# gitignored; .env.example is committed and documents required keys.
#
# Apps each load their own subset of these via process.env at startup.
# Missing variables surface as a clear error from the consuming code, not
# a silent default.

# === Database (used by Prisma + every backend app) ===
# Matches the credentials in infra/compose/docker-compose.yml. Run
# `docker compose -f infra/compose/docker-compose.yml up -d` before any
# `pnpm db:*` command. `connection_limit=40` and `pool_timeout=20` are
# tuned for a hot S3 gateway (mixed read/write); Prisma's defaults are
# too low. Document tuning in apps/gateway/BUILD.md when we get there.
DATABASE_URL="postgresql://kraterion:kraterion@localhost:5432/kraterion?schema=public&connection_limit=40&pool_timeout=20"

# === Redis / Valkey (BullMQ + SessionKey cache) ===
REDIS_URL="redis://localhost:6379"

# === Sui RPC ===
SUI_RPC_URL="https://fullnode.testnet.sui.io:443"

# === Key wrapping (env-AES stand-in for KMS) ===
# 32 bytes hex-encoded. Used to AES-256-GCM-wrap every server-side
# secret stored in the DB (sub-wallet seeds, API key secrets). Generate
# with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Rotating this invalidates every wrapped value in the database.
# DO NOT reuse the dev value in production.
KEY_WRAPPING_MASTER_KEY="<32-byte-hex>"

# === Stripe billing ===
# Must be exactly "test" or "live". Code never inspects the key
# prefix; it switches behavior based on this value (e.g. meter-event
# identifier prefix). Keep test and live runtimes in separate
# processes — never mix.
STRIPE_MODE="test"
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:4001/webhooks/stripe`
# (dev) or the per-endpoint signing secret shown in the Stripe
# dashboard (production).
STRIPE_WEBHOOK_SECRET="whsec_..."

# === MemWal (Walrus Memory) ===
# Per-deployment account on the hosted MemWal relayer. Sign up at
# https://memwal.ai, create an account, and generate a delegate key.
# Per-agent isolation is enforced via namespace (agent:<agent_id>) — one
# shared MemWal account, one namespace per agent. Leaving these unset
# disables the memory.remember / memory.recall tools (the rest of the
# control plane keeps working).
MEMWAL_ACCOUNT_ID="0x..."           # Sui object id of the MemWal Account
MEMWAL_DELEGATE_KEY="<hex>"          # Ed25519 private key from the portal
# MEMWAL_SERVER_URL="https://relayer.memwal.ai"  # optional, this is the default
