// Kraterion authoritative metadata schema.
//
// This schema is the off-chain source of truth for accounts, projects,
// buckets, objects, API keys, and usage events. Every field that mirrors
// on-chain state (Bucket.kraterion_bucket_object_id, S3Object.shared_blob_object_id,
// etc) is populated by the indexer reading events emitted by the Move
// package — see `move/kraterion/sources/events.move`.
//
// See /docs/implementation-plan.md §5 for the full data-model rationale.
// Two corrections to plan §5 reflect decisions logged in /docs/decisions.md:
//   1. encryption_mode is per-bucket, not per-file. The S3Object table
//      drops the column entirely; clients derive it from the parent bucket.
//   2. seal_identity format is [bucket_uid (32) || object_uuid (16)] = 48
//      bytes — no package-id prefix (the Seal SDK adds that at IBE time).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Identity & ownership ===

model Account {
  id          String   @id @default(uuid())
  email       String   @unique
  zklogin_sub String   @unique
  sui_address String   @unique
  status      String   @default("active") // active | cancelled | suspended
  created_at  DateTime @default(now())

  /// First-run onboarding card on the dashboard home. Null = the card
  /// is still eligible to show (gated by per-step completion which is
  /// computed dynamically from buckets / agents / api_keys counts).
  /// Set to `now()` when the user clicks the dismiss ✕; the card stays
  /// hidden until the sidebar "Get started" entry resets this back to
  /// null. We don't store per-step completion — it's derived so a
  /// deleted bucket correctly un-completes step 1.
  onboarding_dismissed_at DateTime?

  projects                 Project[]
  api_decryption_subwallet SubWallet? @relation("api_decryption_for_account")

  @@index([sui_address])
}

model Project {
  id             String   @id @default(uuid())
  account_id     String
  name           String
  default_region String   @default("eu-central-1")
  created_at     DateTime @default(now())

  /// Replayable-runs setting. An AgentSession is auto-flushed (Walrus
  /// blob + Sui anchor) after this many seconds without activity.
  /// Default 5 min — short enough that anchoring keeps up with normal
  /// conversation pacing, long enough to roll a multi-turn exchange
  /// into one on-chain anchor. The demo override is ~60s set per-
  /// project for fast iteration. Hard caps (1 MB / 24h) apply regardless.
  session_idle_seconds Int @default(300)

  account              Account              @relation(fields: [account_id], references: [id])
  buckets              Bucket[]
  api_keys             ApiKey[]
  provider_credentials ProviderCredential[]
  agents               KraterionAgent[]
  agent_sessions       AgentSession[]
  agent_session_traces AgentSessionTrace[]
  /// Lazy 1:1 — set the first time the project does a PUT. The vault is
  /// created on-chain by the gateway (whitelisted on the reserve);
  /// indexer writes this row from `KraterionVaultCreated`.
  storage_pool         StoragePool?
  /// 1:1 billing record. Created lazily the first time the project goes
  /// through Checkout (or eagerly at signup once that flow ships).
  billing_account      BillingAccount?

  @@index([account_id])
}

model ApiKey {
  id         String @id @default(uuid())
  project_id String
  name       String
  // "s3"     → AWS SigV4 keys consumed by the gateway. Populates
  //            access_key_id + secret_wrapped.
  // "bearer" → kr_live_/kr_test_ tokens consumed by the control plane
  //            (CRUD, agent chat, knowledge, MCP). Populates
  //            token_hash + token_prefix + network.
  kind       String @default("s3")

  // === S3 SigV4 keys (kind="s3") ===
  // Public, AWS-style "AKIA..." identifier returned to the user.
  // Nullable so bearer rows can coexist in the same table.
  access_key_id  String? @unique
  // KMS-wrapped secret bytes; never persisted in plaintext.
  secret_wrapped Bytes?

  // === Bearer tokens (kind="bearer") ===
  // sha256(token) — O(1) lookup at auth time. Hash-only storage means a
  // DB compromise cannot reveal the actual tokens; the cleartext is
  // returned exactly once at mint time and thrown away.
  token_hash   String?  @unique
  // Cosmetic preview shown in the dashboard ("kr_test_aB3…X9Z"). Safe
  // to display; not enough to authenticate.
  token_prefix String?
  // "testnet" | "mainnet" — the SUI_NETWORK the control-plane was
  // running on when the token was minted. The bearer guard rejects
  // cross-network use (kr_live_ on a testnet server, etc.) the same
  // way Stripe rejects sk_test_ in live mode.
  network      String?
  // Per-key scope list. Empty = full project access. Future-facing —
  // v1 leaves this empty for all minted tokens.
  scopes       String[] @default([])

  last_used_at DateTime?
  created_at   DateTime  @default(now())
  revoked_at   DateTime?

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@index([access_key_id])
  @@index([token_hash])
}

// === Buckets & objects ===

model Bucket {
  id              String @id @default(uuid())
  project_id      String
  name            String
  region          String @default("eu-central-1")
  // "private" | "public-read". Mirrors on-chain KraterionBucket.encryption_mode.
  // Switching modes is a one-call on-chain flip (set_bucket_visibility) that
  // affects every object in the bucket — there is no per-object override.
  encryption_mode String @default("private")

  // === On-chain bindings ===
  // Sui object ID of the KraterionBucket shared object. Set at bucket
  // creation; never changes.
  kraterion_bucket_object_id String  @unique
  // Application-layer mirror of the on-chain api_decryption_addresses list:
  // true if the gateway is currently authorized to read+write into this
  // bucket. Flipped immediately by the control plane on
  // `revoke_all_api_access`, before the on-chain change has propagated to
  // Seal key servers (which can take seconds).
  api_access_granted         Boolean @default(true)
  // Mirror of bucket.funding_pool balance, refreshed periodically by the
  // health-check worker. BigInt because WAL is u64 on-chain.
  funding_pool_wal_balance   BigInt  @default(0)

  // === Indexer provenance ===
  // The Sui transaction digest + per-tx event index that produced this
  // row. Populated by the gRPC checkpoint indexer at
  // `KraterionBucketCreated`. Nullable today because the gateway's
  // bootstrap script can also create rows directly (until Phase 2
  // removes the gateway-direct write); once the indexer is the sole
  // writer these become NOT NULL.
  tx_digest     Bytes?
  event_seq     Int?
  // Raw `event.parsedJson` archived for re-derivation on Move
  // upgrades. Cheap; replaces the need for a separate audit log.
  event_payload Json?

  // === Bookkeeping ===
  created_at DateTime  @default(now())
  // Soft delete. The on-chain SharedBlob persists regardless — that's the
  // whole point.
  deleted_at DateTime?

  project           Project                  @relation(fields: [project_id], references: [id])
  objects           S3Object[]
  folder_markers    FolderMarker[]
  knowledge         KnowledgeBucketSettings?
  knowledge_queries KnowledgeQuery[]
  agent_buckets     AgentBucket[]

  @@unique([project_id, name])
  // Idempotency key for the indexer: `(tx_digest, event_seq)` is unique
  // per Sui event. Postgres treats multi-NULL composites as distinct,
  // so rows with NULL tx_digest (gateway-direct, pre-Phase-2) coexist
  // with indexer-written rows.
  @@unique([tx_digest, event_seq], map: "Bucket_indexer_event_key")
  @@index([project_id])
  @@index([kraterion_bucket_object_id])
}

model S3Object {
  id           String  @id @default(uuid())
  bucket_id    String
  s3_key       String
  size_bytes   BigInt
  content_type String?
  // MD5 hex of plaintext bytes (S3 API contract — clients verify this).
  etag         String

  // === Walrus / Sui binding (pool model — see /docs/storage-pool-migration.md) ===
  // u256 in URL-safe base64. Walrus's content-addressed blob identifier.
  walrus_blob_id     String
  // Sui object ID of the `walrus::storage_pool::PooledBlob` row inside the
  // project's pool's ObjectTable. Recovered by the gateway from the
  // `KraterionPooledBlobRegistered` event we emit in `pool_vault::register_blob`.
  // Nullable only during the brief register → indexer-ack window; populated by
  // the indexer's `pooled-blob-registered` handler.
  pooled_blob_id     String? @unique
  // Encoded byte size (post-RS expansion), rounded up to whole MiB for
  // pool accounting. Used to verify the off-chain `PooledBlob` rows sum
  // to on-chain `StoragePool.used_encoded_bytes`. Set at insert.
  encoded_size_bytes BigInt  @default(0)

  // === Encryption ===
  // Every file is Seal-encrypted at the gateway, regardless of the bucket's
  // encryption_mode. The bucket mode only controls the seal_approve policy
  // on read; encryption is unconditional.
  // Identity bytes used at IBE encryption time:
  //   [bucket_uid (32) || object_uuid (16)] = 48 bytes.
  // The Seal SDK prepends the package-id prefix; we don't store it.
  // Pool membership is orthogonal to encryption identity — same format
  // as the SharedBlob era.
  seal_identity Bytes

  // === Indexer provenance ===
  // Same shape as `Bucket.tx_digest/event_seq/event_payload`. Populated
  // by `pooled-blob-registered` handler at `KraterionPooledBlobRegistered`.
  // Nullable until the indexer settles the event-derived row (gateway
  // upserts a placeholder during PUT).
  tx_digest     Bytes?
  event_seq     Int?
  event_payload Json?

  // === User metadata ===
  // S3 `x-amz-meta-*` user-provided headers, captured at PUT time as a
  // flat string→string map. AWS caps the total serialized form at 2 KiB;
  // we enforce the same limit at the gateway boundary.
  metadata Json?

  // === Bookkeeping ===
  uploaded_at DateTime  @default(now())
  deleted_at  DateTime?

  bucket              Bucket              @relation(fields: [bucket_id], references: [id])
  pooled_blob         PooledBlob?         @relation(fields: [pooled_blob_id], references: [id])
  knowledge_manifests KnowledgeManifest[]
  knowledge_chunks    KnowledgeChunk[]

  // Latest non-deleted version per (bucket, key). Soft-delete is via
  // deleted_at; we don't keep historical versions for hackathon.
  @@unique([bucket_id, s3_key])
  @@unique([tx_digest, event_seq], map: "S3Object_indexer_event_key")
  @@index([bucket_id, s3_key])
}

// === Operational tables ===

model UsageEvent {
  id          BigInt   @id @default(autoincrement())
  project_id  String
  bucket_id   String?
  // PUT | GET | HEAD | DELETE | LIST
  kind        String
  bytes_in    Int      @default(0)
  bytes_out   Int      @default(0)
  occurred_at DateTime @default(now())

  @@index([project_id, occurred_at])
  @@index([bucket_id, occurred_at])
}

model SubWallet {
  id               String  @id @default(uuid())
  sui_address      String  @unique
  // KMS-wrapped Ed25519 seed/mnemonic. Never persisted in plaintext.
  mnemonic_wrapped Bytes
  // Per-account roles (account_id set):
  //   "api_decryption"     — Seal decryption key per account
  //   "knowledge_indexer"  — embeddings worker, per account
  //   "agent"              — one wallet per agent (linked via KraterionAgent.sub_wallet_id)
  // Global platform roles (account_id null, one wallet per role for the
  // whole platform):
  //   "pool_operator"      — signs all `pool_vault::*` PTBs; on reserve whitelist
  //   "pool_treasury"      — admin on the reserve; signs deposits/rotations
  // Legacy roles removed at the storage_pool cutover:
  //   "publisher"  → folded into pool_operator
  //   "renewal"    → folded into pool_operator (no separate renewal wallet in v1)
  role             String
  // Set for per-account roles. Null for global platform roles
  // (pool_operator, pool_treasury) and for the agent role (one wallet
  // per agent, linked via KraterionAgent.sub_wallet_id).
  account_id       String? @unique

  // Last-known balances, refreshed by the health-check worker. Used to
  // decide when to top up; not authoritative — Sui RPC is.
  sui_balance   BigInt    @default(0)
  wal_balance   BigInt    @default(0)
  last_topup_at DateTime?

  account Account?        @relation("api_decryption_for_account", fields: [account_id], references: [id])
  agent   KraterionAgent?

  @@index([role])
}

// Virtual folder markers for the dashboard's file browser.
//
// S3 has no real folders — they're a UI convention over `/` characters
// in object keys. The dashboard already synthesizes folders from the
// keys it sees, but a user who clicks "New folder" before uploading
// expects to see the empty folder appear right away.
//
// Industry-canonical move is to PUT a 0-byte object with key ending in
// `/` (AWS S3 console, Cloudflare R2, DO Spaces, MinIO all do this).
// For Kraterion that costs ~0.2 WAL and ~30s on-chain wait per empty
// folder — wasteful for a UI affordance. We instead persist the marker
// here and merge it into the listing client-side.
//
// Interop note: a marker is invisible to boto3 / aws-cli until a real
// file is uploaded under its prefix. The S3 API surface is unchanged.
model FolderMarker {
  id         String   @id @default(uuid())
  bucket_id  String
  // Full prefix from bucket root, always normalized to end in "/".
  // Examples: "reports/", "reports/2026/", "reports/2026/Q2/".
  // Empty string is invalid; folders always have a non-zero depth.
  prefix     String
  created_at DateTime @default(now())

  bucket Bucket @relation(fields: [bucket_id], references: [id])

  @@unique([bucket_id, prefix])
  @@index([bucket_id])
}

// === Storage pool tables (Phase D — see /docs/storage-pool-migration.md) ===

/// One `StoragePool` per `Project`. Mirrors the on-chain
/// `kraterion::pool_vault::KraterionPoolVault` (which itself wraps a
/// `walrus::storage_pool::StoragePool` as a field). Rows are written by
/// the indexer's `vault-created` handler on `KraterionVaultCreated`; the
/// gateway reads them at PUT time to find the vault object ID for the
/// register/certify PTBs.
///
/// Capacity columns (`reserved_encoded_bytes`, `used_encoded_bytes`,
/// `blob_count`) are kept in sync by the indexer on every pool-touching
/// event. They're the authoritative quick-read; for absolute truth,
/// query the on-chain pool object directly.
model StoragePool {
  id                     String    @id @default(uuid())
  project_id             String    @unique
  /// `KraterionPoolVault` Sui ObjectID (shared object).
  vault_object_id        String    @unique
  /// `walrus::storage_pool::StoragePool` ObjectID (held as a field inside
  /// the vault — never directly addressable but useful for debugging /
  /// auditing on Suiscan).
  pool_object_id         String    @unique
  reserved_encoded_bytes BigInt
  used_encoded_bytes     BigInt    @default(0)
  blob_count             Int       @default(0)
  start_epoch            Int
  end_epoch              Int
  /// User-side kill switch mirror. Flipped to true by the
  /// `vault-revoked` handler on `KraterionVaultRevoked`. Gateway checks
  /// this before attempting writes (cheap pre-flight; the on-chain
  /// `assert!(vault.platform_authorized)` is the authoritative gate).
  user_revoked           Boolean   @default(false)
  /// active | expired | user_revoked
  status                 String    @default("active")
  /// Sui address of the user who owns the project this pool serves.
  /// Mirror of on-chain `vault.created_by`. Set at insert from the
  /// `KraterionVaultCreated` event; never updated thereafter.
  created_by_address     String
  created_at             DateTime  @default(now())
  last_extended_at       DateTime?
  last_resized_at        DateTime?
  last_synced_at         DateTime  @default(now())
  /// Indexer provenance for the `KraterionVaultCreated` event.
  tx_digest              Bytes?
  event_seq              Int?

  project      Project                @relation(fields: [project_id], references: [id])
  pooled_blobs PooledBlob[]
  extensions   StoragePoolExtension[]

  @@unique([tx_digest, event_seq], map: "StoragePool_indexer_event_key")
  @@index([end_epoch])
  @@index([status])
}

/// One row per PooledBlob inside a StoragePool. Mirrors
/// `walrus::storage_pool::PooledBlob` (stored inside the pool's internal
/// ObjectTable; never an owned object).
///
/// Inserted by the indexer's `pooled-blob-registered` handler on
/// `KraterionPooledBlobRegistered`; `status` advances to `certified` on
/// `KraterionPooledBlobCertified`, then `deleted` on
/// `KraterionPooledBlobDeleted`. The gateway's `indexer-wait` polls for
/// `status='certified'` to confirm the PUT can return 200.
model PooledBlob {
  id                    String    @id @default(uuid())
  storage_pool_id       String
  /// u256 in URL-safe base64. Walrus's content-addressed blob ID.
  walrus_blob_id        String
  /// Sui ObjectID of the on-chain PooledBlob row inside the pool's
  /// ObjectTable. Recovered from the `KraterionPooledBlobRegistered`
  /// event payload.
  pooled_blob_object_id String    @unique
  /// Encoded size in bytes (post-RS expansion). Used for pool accounting.
  encoded_size_bytes    BigInt
  registered_epoch      Int
  certified_epoch       Int?
  /// registered | certified | deleted
  status                String    @default("registered")
  registered_at         DateTime  @default(now())
  certified_at          DateTime?
  deleted_at            DateTime?

  storage_pool  StoragePool        @relation(fields: [storage_pool_id], references: [id])
  s3_object     S3Object?
  session_trace AgentSessionTrace?

  @@index([storage_pool_id, status])
  @@index([walrus_blob_id])
}

/// Audit log for pool lifecycle ops (`extend`, `resize_grow`, future
/// `resize_shrink`). Mirrors the per-event idempotency pattern that
/// `S3ObjectExtension` used in the SharedBlob era — handlers insert
/// here with `(tx_digest, event_seq) UNIQUE` to dedupe on replay.
model StoragePoolExtension {
  id                  String   @id @default(uuid())
  storage_pool_id     String
  /// 'extend' | 'resize_grow' | 'resize_shrink'
  kind                String
  prev_end_epoch      Int?
  new_end_epoch       Int?
  prev_reserved_bytes BigInt?
  new_reserved_bytes  BigInt?
  /// WAL spent for this op (informational; ground truth is on-chain).
  wal_cost_frost      BigInt   @default(0)
  tx_digest           Bytes
  event_seq           Int
  occurred_at         DateTime @default(now())

  storage_pool StoragePool @relation(fields: [storage_pool_id], references: [id])

  @@unique([tx_digest, event_seq])
  @@index([storage_pool_id, occurred_at])
}

// === Knowledge layer (additive; opt-in per bucket) ===
//
// See `docs/ai-features-plan.md` §4. Existence of `KnowledgeBucketSettings`
// for a bucket means the worker auto-indexes every supported object PUT
// into it. Toggling off deletes the settings row and all chunks; manifest
// rows + on-Walrus manifest blobs persist as audit. Revoking on-chain
// API access short-circuits search/ask without touching the index.

model KnowledgeBucketSettings {
  bucket_id            String   @id
  embedding_model      String   @default("text-embedding-3-small")
  embedding_dimensions Int      @default(1024)
  // "recursive" for v1; "semantic" reserved as a stretch.
  chunking_strategy    String   @default("recursive")
  chunk_tokens         Int      @default(400)
  chunk_overlap_tokens Int      @default(60)
  // Note: previously `default_llm_model` lived here as the bucket's
  // default chat model for `/ask`. With the P3 agent layer, model
  // selection moved to `KraterionAgent.model`. The column was dropped
  // in the 2026-05-13 agents migration.
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  bucket Bucket @relation(fields: [bucket_id], references: [id])
}

model KnowledgeManifest {
  // One row per (s3_object_id, version). Re-indexing on overwrite or
  // model change bumps `version` and writes a new manifest blob.
  id                             String    @id @default(uuid())
  s3_object_id                   String
  // Denormalized so bucket-scoped queries don't have to join through
  // S3Object. Same shape as KnowledgeChunk.bucket_id.
  bucket_id                      String
  version                        Int       @default(1)
  // "queued" | "indexing" | "indexed" | "skipped" | "failed"
  status                         String
  // "unsupported_mime" | "too_large" | "empty" | etc. Populated when
  // status = "skipped" so the dashboard can explain why.
  skip_reason                    String?
  embedding_model                String?
  embedding_dimensions           Int?
  chunk_count                    Int       @default(0)
  // Walrus blob id of the manifest archive (a PooledBlob in the
  // project's pool, owned via `pool_vault::register_blob`).
  // Null until K5 archive completes.
  manifest_walrus_blob_id        String?
  // Renamed from `manifest_shared_blob_object_id` at the storage-pool
  // migration. Sui ObjectID of the on-chain `PooledBlob` carrying the
  // manifest JSON. The dashboard surfaces this as a Sui-explorer link.
  manifest_pooled_blob_object_id String?
  bytes_in                       BigInt    @default(0)
  bytes_indexed                  BigInt    @default(0)
  embedding_tokens               Int       @default(0)
  error_detail                   String?
  started_at                     DateTime?
  finished_at                    DateTime?
  // Soft-delete on DeleteObject / DeleteBucket / overwrite. Chunks are
  // hard-deleted; the row stays so historical KnowledgeQuery citations
  // resolve. The Walrus manifest blob persists regardless.
  deleted_at                     DateTime?
  created_at                     DateTime  @default(now())

  s3_object S3Object         @relation(fields: [s3_object_id], references: [id])
  chunks    KnowledgeChunk[]

  @@unique([s3_object_id, version])
  @@index([bucket_id, status])
}

model KnowledgeChunk {
  // Live retrieval index. Replaced wholesale when a manifest version
  // bumps (chunks cascade-delete; the manifest row stays for audit and
  // its on-chain blob remains user-owned).
  id           String                       @id @default(uuid())
  bucket_id    String
  s3_object_id String
  manifest_id  String
  ordinal      Int
  // SHA-256 of the chunk plaintext. Manifest archives this list so the
  // index can be rebuilt deterministically from on-chain artifacts.
  content_hash Bytes
  // Chunk plaintext, un-encrypted at rest. Justification in
  // `docs/ai-features-plan.md` §4 — the bucket owner opted in, the
  // gateway already decrypts at ingest, and search short-circuits on
  // `api_access_granted` revocation.
  content      String                       @db.Text
  // pgvector halfvec; populated by `$executeRaw` because Prisma can't
  // serialize halfvec natively. Reads use `$queryRaw` with `<=>`.
  embedding    Unsupported("halfvec(1024)")
  // Generated `tsvector` (Postgres `GENERATED ALWAYS AS (...) STORED`)
  // for K2 hybrid BM25 retrieval. Populated automatically on every
  // INSERT/UPDATE of `content`; never written manually. Modelled as
  // Unsupported because Prisma can't represent generated columns
  // natively. The K2 search query uses `content_tsv @@ plainto_tsquery(...)`
  // and combines vector + BM25 ranks with Reciprocal Rank Fusion.
  content_tsv  Unsupported("tsvector")?
  token_count  Int
  start_offset Int
  end_offset   Int

  manifest  KnowledgeManifest @relation(fields: [manifest_id], references: [id], onDelete: Cascade)
  s3_object S3Object          @relation(fields: [s3_object_id], references: [id])

  @@unique([manifest_id, ordinal])
  @@index([bucket_id])
}

model KnowledgeQuery {
  // Audit + activity feed source. One row per `/search` or `/ask` call.
  id           String   @id @default(uuid())
  bucket_id    String
  // Denormalized for activity scoping (per-project history without a
  // join through Bucket).
  project_id   String
  // Null when the query came via a session-authed dashboard caller
  // rather than an API key.
  api_key_id   String?
  // "search" | "ask"
  kind         String
  query        String   @db.Text
  top_k        Int
  latency_ms   Int
  chunk_count  Int
  // Hashes of the chunks returned — supports "the agent's answer was
  // backed by these citations" replay.
  cited_hashes Bytes[]
  llm_model    String?
  llm_tokens   Int?
  created_at   DateTime @default(now())

  bucket Bucket @relation(fields: [bucket_id], references: [id])

  @@index([bucket_id, created_at])
  @@index([project_id, created_at])
}

// === Indexer bookkeeping ===
//
// One `IndexerCursor` row per gRPC pipeline source. Today we run a
// single source `kraterion-package-v1` covering all 11 events from
// the kraterion package (the kraterion + reserve modules emit them
// all under one packageId). The cursor advances per checkpoint.
//
// `last_checkpoint_seq` is the gRPC-native unit of progress. The
// per-checkpoint commit transaction sets it to the checkpoint's
// `sequence_number` after every event in that checkpoint has been
// processed (or DLQ'd). Skipping empty checkpoints is fine — the
// cursor advances regardless, otherwise we re-scan them forever.
//
// `last_tx_digest` and `last_event_seq` are diagnostic only: they
// record the last event we saw inside the last checkpoint, so a human
// reading the row can pinpoint the watermark without grepping logs.
model IndexerCursor {
  source_id           String   @id
  last_checkpoint_seq BigInt
  last_tx_digest      Bytes?
  last_event_seq      Int?
  updated_at          DateTime @default(now()) @updatedAt
}

// Failed event quarantine. Per-event try/catch in the run-loop writes
// rows here on parse error / handler throw / schema mismatch; the
// cursor still advances past the offending event so a poison pill
// never freezes the queue.
//
// `(source_id, tx_digest, event_seq)` is the natural idempotency key:
// re-encountering the same event on a backfill bumps `retries` rather
// than creating a duplicate row.
model IndexerDeadLetter {
  id              String   @id @default(uuid())
  source_id       String
  checkpoint_seq  BigInt
  tx_digest       Bytes
  event_seq       Int
  // Fully-qualified Move type, e.g.
  // "0x27e1…::events::KraterionObjectCreated".
  event_type      String
  payload         Json
  error_message   String
  error_stack     String?
  retries         Int      @default(0)
  // pending | parked | resolved
  status          String   @default("pending")
  first_seen_at   DateTime @default(now())
  last_attempt_at DateTime @default(now())

  @@unique([source_id, tx_digest, event_seq])
  @@index([source_id, status])
}

// === MCP OAuth (K3b) ===
//
// Two tables enabling RFC 7591 Dynamic Client Registration + OAuth 2.1
// authorization-code flow with PKCE + RFC 8707 Resource Indicators.
//
// Tokens themselves are JWTs (not DB-backed) — the verifier checks
// signature + `aud` + `exp` offline. The DB only stores the
// client registration metadata and the short-lived authorization
// codes (which DO need a DB lookup because the spec mandates
// single-use codes).
//
// See `docs/ai-features-plan.md` §6.4.2 and the 2026-05-12 K3b ADR
// in `docs/decisions.md` for the architecture rationale.

model OAuthClient {
  // RFC 7591 anonymous Dynamic Client Registration. Returned to the
  // MCP client at registration time; it carries the value in every
  // subsequent /authorize and /token call.
  id            String    @id @default(uuid())
  client_id     String    @unique
  // Free-form name supplied by the client (`Cursor`, `Claude Desktop`,
  // etc.). Surfaces on the consent screen so the user knows what
  // they're approving.
  client_name   String?
  // PKCE clients can have multiple redirect URIs. We validate the
  // submitted redirect_uri at /authorize time against this set.
  redirect_uris String[]
  // Lifecycle. `last_used_at` updates on every token exchange;
  // garbage-collection by age is a post-hackathon worker.
  created_at    DateTime  @default(now())
  last_used_at  DateTime?
  // No client_secret column — MCP-spec public clients use PKCE,
  // never a secret.

  @@index([last_used_at])
}

model OAuthGrant {
  // Authorization code, single-use. We row-insert at /authorize and
  // row-update with `consumed_at` at /token (with a guard against
  // double-spend). After consume the row stays for a short window
  // (so a curious second /token attempt gets a "code already used"
  // error rather than a 404) then is GC'd.
  id             String    @id @default(uuid())
  client_id      String // FK reference is logical only — the
  // anonymous DCR client could be GC'd; we
  // store the id for audit.
  // Resolved at /authorize via the user's CP session. The /token
  // exchange mints a JWT with `sub=account_id` so the MCP guard can
  // resolve the principal symmetrically with the bearer path.
  account_id     String
  // Project the grant is scoped to. The dashboard's consent UI picks
  // this (single-project today; multi-project consent is post-K3b).
  project_id     String
  scopes         String[] // e.g. ["mcp:read","mcp:write","mcp:ask"]
  code           String    @unique
  // PKCE S256: the SHA-256 hash of the verifier, sent at /authorize.
  // We compare against `sha256(verifier)` at /token.
  code_challenge String
  // RFC 8707: the resource (MCP URL) this token is for. The /token
  // response embeds this as the JWT `aud` claim; the MCP guard
  // rejects tokens whose `aud` doesn't match the live request.
  resource       String
  redirect_uri   String
  created_at     DateTime  @default(now())
  consumed_at    DateTime?
  expires_at     DateTime // 60s typical — short-lived by RFC 7636

  @@index([client_id])
  @@index([account_id])
}

/// Stored third-party API credentials, scoped to a Project. Keyed by
/// `(project_id, provider)` — one credential per provider per project.
///
/// AI features (worker embeddings, /ask, /search query embedding,
/// MCP kraterion_ask) read the project's OpenAI credential via the
/// `useDecrypted` accessor; the plaintext key is held in memory only
/// during the closure that needs it. Replaces the process-wide
/// `OPENAI_API_KEY` env var.
///
/// Schema is provider-tagged so additional providers (Anthropic,
/// Cohere) can be added later without migration — they'd insert
/// rows with `provider = 'anthropic'` etc.
model ProviderCredential {
  id             String    @id @default(uuid())
  project_id     String
  // Free-form lowercase identifier. Only 'openai' at launch; future
  // values like 'anthropic', 'cohere' don't require a schema change.
  provider       String
  // KMS-wrapped via EnvKeyWrapper. Format matches ApiKey.secret_wrapped:
  // [12 byte nonce | ciphertext | 16 byte auth tag]. Never logged,
  // never returned to the dashboard wire.
  encrypted_key  Bytes
  // Last 4 chars of the plaintext key. Displayed as "sk-…ABCD" in the
  // dashboard so users can confirm which key is stored without ever
  // exposing the full secret again.
  key_last_4     String
  // 'active' | 'invalid' | 'revoked'. Validation pings provider's
  // /models endpoint on upsert and any time `useDecrypted` succeeds
  // (background refresh). Transient network failures don't flip the
  // status — only an explicit 401.
  status         String    @default("active")
  last_validated DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, provider])
  @@index([project_id])
}

/// P3 — First-class Agents resource.
///
/// A KraterionAgent is a user-configured RAG agent owned by a project.
/// It bundles a system prompt, a chat model, retrieval params, and a
/// set of attached buckets into a single addressable resource with a
/// stable OpenAI Chat Completions-compatible endpoint at
/// `POST /v1/agents/:id/chat/completions`.
///
/// Each agent ships with its own sub-wallet (role='agent'), which gets
/// registered as an authorized API decryption address on every
/// attached bucket via the existing Move `grant_api_access` flow.
/// Revoking the agent is a sponsored on-chain tx that
/// `revoke_all + grant(gateway + indexer + remaining_active_agents)`,
/// taking the agent off the bucket's grant list without breaking the
/// other principals.
model KraterionAgent {
  id            String  @id @default(uuid())
  project_id    String
  // Human-readable label. Unique within a project so a project owner
  // can refer to agents by name in API calls and URLs.
  name          String
  description   String?
  // Per-agent system prompt. Wrapped around the retrieval context at
  // chat time. Free-form text; the dashboard validates length.
  system_prompt String  @db.Text
  // Chat model id from the shared catalog (e.g. "gpt-4o-mini").
  // Per-request override allowed via the `model` field on
  // /chat/completions, same as OpenAI.
  model         String
  // Sampling controls — sane defaults matching the previous /ask flow.
  temperature   Float   @default(0.2)
  max_tokens    Int     @default(1024)
  // Retrieval top-k applied when this agent calls `KnowledgeService.search`.
  top_k         Int     @default(8)
  // 'active' | 'revoked'. Revoke flips this AND fires the on-chain
  // re-grant PTB; chat endpoint refuses to serve when not 'active'.
  status        String  @default("active")
  // P5 stub. Always null at submission; the column is here so plugging
  // in guardrails post-hackathon is additive only.
  guardrails_id String?
  // Sub-wallet provisioned at create time. 1:1 — when the agent is
  // deleted the wallet stays in SubWallet for audit but is unlinked
  // (via the relation's optional side).
  sub_wallet_id String  @unique

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  revoked_at DateTime?

  project      Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sub_wallet   SubWallet         @relation(fields: [sub_wallet_id], references: [id])
  buckets      AgentBucket[]
  tools        AgentTool[]
  invocations  AgentInvocation[]
  share_tokens AgentShareToken[]
  sessions     AgentSession[]

  @@unique([project_id, name])
  @@index([project_id])
}

/// Many-to-many junction between agents and buckets. An agent reads
/// from every attached bucket at retrieval time; attaching is a
/// no-op for already-attached buckets, detaching emits the per-agent
/// on-chain revoke for that bucket only.
model AgentBucket {
  agent_id   String
  bucket_id  String
  created_at DateTime @default(now())

  agent  KraterionAgent @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  bucket Bucket         @relation(fields: [bucket_id], references: [id])

  @@id([agent_id, bucket_id])
  @@index([bucket_id])
}

/// Many-to-many junction between agents and the built-in tool registry.
/// Each row enables one tool (by name) for one agent. The registry is
/// hard-coded server-side; an unknown `tool_name` is rejected at
/// agents.service write time.
///
/// `tool_kind` is a forward-compat discriminator — v1 only writes
/// "builtin"; "webhook" (per-agent HTTP tools) and "mcp" (Kraterion
/// consuming external MCP tool catalogs) are post-hackathon
/// extensions that drop in here without a migration.
model AgentTool {
  agent_id   String
  tool_name  String
  tool_kind  String   @default("builtin")
  created_at DateTime @default(now())

  agent KraterionAgent @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@id([agent_id, tool_name])
  @@index([agent_id])
}

/// One row per `/chat/completions` call against an agent. Captures
/// auth principal, retrieval breakdown, token counts, citations, and
/// the final answer for the Activity feed + replay/audit.
///
/// Row is created with `status='pending'` *before* the LLM call so
/// failures (credential missing, agent revoked mid-flight, provider
/// 5xx) still produce an audit trail. The handler patches the row to
/// 'completed' or 'failed' before returning.
model AgentInvocation {
  id              String  @id @default(uuid())
  agent_id        String
  // Denormalized for activity scoping. Same `project_id` as the
  // parent agent.
  project_id      String
  // Auth principal — exactly one of these is set per invocation, based
  // on which guard branch authenticated the request.
  user_id         String? // session JWT
  api_key_id      String? // bearer API key (gateway-style AKIA)
  oauth_client_id String? // OAuth 2.1 / MCP DCR
  // P6: embed widget share-token. Anonymous traffic from the customer's
  // own site; the token (not a user) is the principal we audit against.
  share_token_id  String?

  /// Parent AgentSession this invocation rolls into. Set on the live path
  /// before the LLM call. Nullable for backfill safety + agents with no
  /// attached knowledge bucket (sessionless, no on-chain anchor produced).
  session_id String?

  // 'pending' | 'completed' | 'failed' | 'revoked'.
  // 'revoked' is set when the agent was revoked mid-request (post-credential-fetch, pre-LLM-call).
  status String @default("pending")

  // The user's input — the last `messages[]` entry on the request.
  // Stored in full so the Activity feed can render the conversation
  // snippet without a separate messages table.
  input  String  @db.Text
  output String? @db.Text

  // Model actually invoked (may differ from agent.model when the
  // caller overrides per-request).
  model             String
  prompt_tokens     Int?
  completion_tokens Int?

  retrieval_latency_ms Int?
  llm_latency_ms       Int?
  latency_ms           Int? // total wall clock; nullable while pending

  // Bucket ids the retrieval stage hit. Many-to-one against AgentBucket
  // at the moment the request was processed (an agent's buckets can
  // change between invocations).
  bucket_ids   String[]
  // Cited chunk hashes (SHA-256). Aligned with [chunk N] markers in
  // `output` and resolvable against on-chain manifests for verification.
  cited_hashes Bytes[]

  /// Frozen retrieval breakdown at the moment of this turn. JSON array of
  /// `{bucket_id, chunk_id, ordinal, content_hash, s3_key, rrf_score}` —
  /// no chunk text, recoverable by hash. Used by the session-archive
  /// worker to assemble the canonical trace blob, and by the replay
  /// endpoint to short-circuit retrieval on re-execution. Null while the
  /// invocation is still pending; populated at completion.
  retrieval_snapshot Json?

  /// OpenAI `seed` parameter for this turn. Derived from the first 4
  /// bytes of `id` interpreted as int32 so replays are reproducible
  /// given the same input. Null on legacy rows + on provider paths
  /// that don't support seed.
  seed Int?
  /// OpenAI `system_fingerprint` returned with the completion.
  /// Identifies the backend config version. On replay, a mismatch
  /// surfaces as a yellow banner ("backend changed since this run") —
  /// determinism guarantees fall back to best-effort.
  system_fingerprint String?

  // Billing imputation. Populated by the agents controller right after
  // the OpenAI response, using the price catalog snapshot recorded in
  // `cost_price_version` so the dollar value is immune to later
  // OpenAI repricing.
  //   - `key_source = 'platform'` → an `agent_messages` MeterEvent row
  //     is emitted alongside this invocation.
  //   - `key_source = 'byok'`     → tokens roll into BYOKDailySpend
  //     instead; no MeterEvent is emitted (BYOK is display-only).
  // `cost_usd_micros` stays at 0 for failed/revoked invocations.
  cost_usd_micros   BigInt  @default(0)
  cost_price_version String?
  key_source        String? // 'platform' | 'byok'

  error_detail String?

  created_at  DateTime  @default(now())
  finished_at DateTime?

  agent      KraterionAgent  @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  tool_calls AgentToolCall[]
  session    AgentSession?   @relation(fields: [session_id], references: [id])

  @@index([agent_id, created_at])
  @@index([project_id, created_at])
  @@index([session_id])
}

/// Per-tool-call audit row. Zero-to-many per AgentInvocation; one row
/// for each `tool_calls[]` item the model emits across all rounds of
/// the tool-call loop.
///
/// `tx_digest` is populated for tools that mint an on-chain Move tx
/// (today: `kraterion_write_object`). The control plane polls
/// `S3Object` after the gateway PUT settles and copies the indexer's
/// tx digest here so the dashboard can render a Suiscan link without
/// a second round-trip. Null for read tools and for writes still
/// indexing — the dashboard falls back to "indexing…".
model AgentToolCall {
  id            String @id @default(uuid())
  invocation_id String
  // The OpenAI-issued `tool_calls[].id`. Stable across streaming
  // deltas; deduplicates if the same call is re-processed.
  tool_call_id  String
  tool_name     String
  // 'pending' | 'completed' | 'failed'.
  status        String @default("pending")
  // Round index within the parent invocation, starting at 0. Caps
  // pathological loops at MAX_TOOL_ROUNDS (enforced application-side).
  round         Int

  // Raw arguments JSON emitted by the model — stored even if validation
  // fails so the dashboard can show what was attempted.
  arguments   String  @db.Text
  // String form the model sees as the tool result. JSON-stringified
  // when the underlying handler returns structured data.
  output      String? @db.Text
  // Structured metadata captured by the handler for the dashboard
  // (walrus_blob_id, pooled_blob_object_id, etag, etc.). Not fed back
  // to the model.
  output_json Json?

  // On-chain receipt for tools that emit a Move tx. Populated by
  // polling S3Object after writes settle. Renamed from
  // `shared_blob_object_id` at the storage-pool migration cutover.
  tx_digest             String?
  walrus_blob_id        String?
  pooled_blob_object_id String?

  latency_ms   Int?
  error_detail String?

  created_at  DateTime  @default(now())
  finished_at DateTime?

  invocation AgentInvocation @relation(fields: [invocation_id], references: [id], onDelete: Cascade)

  @@unique([invocation_id, tool_call_id])
  @@index([invocation_id, created_at])
}

/// A buffered, multi-turn agent conversation. One row spans N
/// `AgentInvocation`s for the same agent + principal until idle for
/// `Project.session_idle_seconds` (default 600s), trace exceeds 1 MB, or
/// session age exceeds 24h — whichever first. On flush, the worker
/// builds a canonical-JSON trace, Seal-encrypts, registers as a
/// PooledBlob in the project's pool, and emits `KraterionSessionAnchored`
/// in the same PTB as `register_blob`. The anchor tx digest is the
/// replay handle.
///
/// `principal_kind` mirrors `AgentInvocation`'s auth columns:
/// 'user' | 'api_key' | 'oauth_client' | 'share_token'. `principal_id`
/// is the matching ID (User.id / ApiKey.id / OAuthClient.id /
/// AgentShareToken.id). Session keying is `(agent_id, principal_kind,
/// principal_id)`; the SDK middleware may override via
/// `X-Kraterion-Session-Id` to join sessions explicitly.
model AgentSession {
  id         String @id @default(uuid())
  project_id String
  agent_id   String

  /// 'user' | 'api_key' | 'oauth_client' | 'share_token'.
  principal_kind String
  /// Matching ID for `principal_kind`. Not a FK because the target table
  /// varies; the agents controller validates the join at attach time.
  principal_id   String

  /// 'open' | 'flushing' | 'anchored' | 'failed'. State machine:
  ///   open       — accepting more invocations
  ///   flushing   — sweeper picked it up; worker job pending
  ///   anchored   — Walrus blob + Sui event committed; immutable
  ///   failed     — worker exhausted retries; surfaced in dashboard
  status String @default("open")

  opened_at        DateTime  @default(now())
  /// Bumped on every chat completion. The sweeper reads this against
  /// `now - Project.session_idle_seconds` to find sessions to flush.
  last_activity_at DateTime  @default(now())
  closed_at        DateTime?
  /// 'idle' | 'size_cap' | 'age_cap' | 'explicit_end'. Set at flush.
  close_reason     String?

  invocation_count Int @default(0)

  /// 32-byte Sui digest. Set by the indexer when
  /// `KraterionSessionAnchored` lands. Until then, null.
  anchored_tx_digest Bytes?

  project     Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  agent       KraterionAgent    @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  invocations AgentInvocation[]
  trace       AgentSessionTrace?

  @@index([agent_id, principal_kind, principal_id, status])
  @@index([status, last_activity_at])
  @@index([project_id, opened_at])
}

/// On-chain artifact for one anchored AgentSession. Indexer writes this
/// from `KraterionSessionAnchored`. Joined to the PooledBlob row written
/// by the paired `KraterionPooledBlobRegistered` event in the same tx.
model AgentSessionTrace {
  id             String @id @default(uuid())
  session_id     String @unique
  project_id     String
  pooled_blob_id String @unique

  /// Mirror of PooledBlob.walrus_blob_id for direct lookup without join.
  walrus_blob_id String
  /// 48-byte Seal IBE identity: `bucket_uid (32) || session_uuid (16)`.
  seal_identity  Bytes
  /// 32-byte SHA-256 of the canonical-JSON, plaintext trace bytes.
  trace_hash     Bytes
  /// Number of distinct chat completions rolled into the trace.
  invocation_count       Int
  /// Plaintext serialized JSON bytes (pre-gzip, pre-Seal). For dashboard
  /// display and the size-cap path.
  trace_size_bytes       Int
  /// Gzipped, post-Seal bytes — what we actually paid Walrus to store.
  trace_gzip_size_bytes  Int

  /// 32-byte Sui digest of the anchor tx. URL-safe replay handle.
  tx_digest  Bytes
  event_seq  Int

  anchored_at DateTime @default(now())

  session     AgentSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  pooled_blob PooledBlob   @relation(fields: [pooled_blob_id], references: [id])

  @@unique([tx_digest, event_seq])
  @@index([project_id, anchored_at])
}

/// P6 — Embeddable chat widget share token. Customers paste a
/// `<script>` snippet on their own site that opens an iframe pointed
/// at our dashboard's `/embed/chat/[agentId]` route. The widget
/// authenticates with this token (one per "deployment surface"); the
/// token is scoped to exactly one agent, never to the project broadly.
///
/// Storage mirrors the bearer API-key shape: SHA-256 hash of the
/// token is the lookup key; cleartext is returned exactly once at
/// mint time and never persisted. Format: `kr_share_<env>_<36 chars>`.
///
/// Anonymous traffic from a customer's site means we lock the token
/// down on three axes:
///   - **Origin allowlist** — `allowed_origins` is checked against the
///     request's `Origin` header on every call.
///   - **Daily request cap** — `max_requests_per_day` rolled at UTC
///     midnight via `ShareTokenUsageDay`.
///   - **Daily USD spend cap** — `max_spend_usd_micros_per_day` rolled
///     the same way, debited per turn using completion-token usage ×
///     per-million model price from `@kraterion/shared`.
model AgentShareToken {
  id           String @id @default(uuid())
  agent_id     String
  // Human-readable label (e.g. "marketing site widget").
  name         String
  // sha256(cleartext) — same pattern as ApiKey.token_hash.
  token_hash   String @unique
  // Cosmetic preview shown in the dashboard ("kr_share_test_aB3…X9Z").
  token_prefix String
  // "testnet" | "mainnet" — same network gate as bearer tokens. A
  // `kr_share_test_…` token presented to a mainnet deployment is
  // rejected at resolver time.
  network      String

  // Origin allowlist (e.g. ["https://docs.example.com",
  // "https://www.example.com"]). Empty array = no origins allowed
  // (the token is dormant — requires the user to set this before the
  // embed will accept calls). The resolver rejects when the request's
  // `Origin` header isn't in the list.
  allowed_origins String[] @default([])

  // Per-day caps. NULL = unlimited; daily counters in
  // `ShareTokenUsageDay`. The chat endpoint refuses with 429 once a
  // cap is hit.
  max_requests_per_day         Int?
  max_spend_usd_micros_per_day BigInt?

  // When true (default), the model's system prompt includes the
  // `[chunk N]` citation contract and the response carries the
  // citations panel + retrieval-info extension. When false, the
  // citation instructions are stripped from the prompt entirely
  // (so the model produces clean prose), and the response's
  // `kraterion` extension carries no citations or retrieval info.
  //
  // Site owners disable this when the widget is on a public-facing
  // surface where exposing internal source paths is wrong — e.g. a
  // marketing-site help widget shouldn't quote internal handbook
  // chunks back at visitors.
  cite_sources Boolean @default(true)

  last_used_at DateTime?
  created_at   DateTime  @default(now())
  revoked_at   DateTime?

  agent      KraterionAgent       @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  usage_days ShareTokenUsageDay[]

  @@index([agent_id])
  @@index([token_hash])
}

/// Per-token, per-UTC-day rolling counter for share token caps.
/// Upserted on every successful chat invocation; cap-check reads the
/// row right before issuing the LLM call. Rows older than a couple of
/// days are stale audit; can be reaped by a future cleanup job.
model ShareTokenUsageDay {
  share_token_id   String
  // UTC date as YYYY-MM-DD. Avoids timezone foot-guns in WHERE clauses.
  day_utc          String
  // Number of chat completions completed (failures + over-cap rejects
  // do NOT increment).
  requests         Int      @default(0)
  // USD spend in micro-dollars (i.e. 1e-6 USD). Aggregates the per-turn
  // (output_tokens / 1_000_000) * price_per_m_tokens_usd computation.
  spend_usd_micros BigInt   @default(0)
  // Approximate bytes egressed through this share token today —
  // counted as `completion_tokens × 4` per chat completion (UTF-8
  // tokens average ~4 bytes per token). Source for the
  // `share_token_egress_bytes` Stripe meter; kept separate from the
  // gateway egress meter so we can detect public-link abuse without
  // double-billing the same byte.
  bytes_out        BigInt   @default(0)
  // Cursor for the share-token-egress rollup processor. Each tick
  // computes `bytes_out - bytes_out_at_last_emit` and emits the delta
  // as a MeterEvent; afterwards this field is set to `bytes_out`.
  // Null on first observation.
  bytes_out_at_last_emit BigInt? @default(0)
  updated_at       DateTime @updatedAt

  share_token AgentShareToken @relation(fields: [share_token_id], references: [id], onDelete: Cascade)

  @@id([share_token_id, day_utc])
  @@index([share_token_id])
  // Drives the daily roll-up worker: "find every row touched today
  // that has a non-zero bytes_out delta since last emit".
  @@index([day_utc])
}

// === Billing layer (P8 — Stripe pay-as-you-go, sandbox only for v1) ===
//
// One BillingAccount per Project. Stripe is the billing source of truth;
// these tables are the durable local log, reconciliation source, and
// dashboard read surface. See /docs/monetization-and-billing.md and the
// active plan at .claude/plans/idempotent-tumbling-thompson.md.
//
// Storage is a licensed (flat) subscription item — `quantity = reserved_gb`
// kept in sync with `StoragePool.reserved_encoded_bytes`. Class A / B,
// egress, knowledge index, agent messages are metered with graduated
// prices (tier-1 zero amount = free band).

/// 1:1 with Project. Created lazily on Checkout. `stripe_customer_id_test`
/// and `*_live` are split so we can run sandbox and production with the
/// same row layout — only one is active per environment, gated by
/// STRIPE_MODE.
model BillingAccount {
  id                           String   @id @default(cuid())
  project_id                   String   @unique
  stripe_mode                  String   @default("test") // 'test' | 'live'
  stripe_customer_id_test      String?  @unique
  stripe_customer_id_live      String?  @unique
  status                       String   @default("active") // active | past_due | cancelled
  has_payment_method           Boolean  @default(false)
  default_payment_method       String?
  currency                     String   @default("usd")
  /// Falls back to `Account.email` when null. Stripe sends invoices here.
  billing_email                String?
  tax_id                       String?
  country                      String?
  /// In USD cents. Null means no cap. Storage subscription line is
  /// EXEMPT from this cap (fixed monthly reservation); only metered
  /// items respect it.
  hard_spend_cap_usd_cents     Int?
  /// Percent thresholds for soft-alert emails / Slack webhooks (e.g.
  /// 50, 80, 100). Empty array disables alerts.
  soft_alert_thresholds        Int[]    @default([50, 80, 100])
  upload_rate_limit_gb_per_day Int      @default(1024)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id])

  @@index([stripe_customer_id_test])
  @@index([stripe_customer_id_live])
}

/// One row per Stripe meter event we owe to the API. Written first by
/// the agent / rollup paths, then drained to Stripe by the meter-emit
/// worker. `identifier` is UNIQUE so retries inside Stripe's 24h dedupe
/// window are safe. Includes a `{mode}:` prefix to keep test and live
/// emits from ever colliding.
model MeterEvent {
  id            String    @id @default(cuid())
  project_id    String
  meter_name    String
  value         BigInt
  identifier    String    @unique
  /// Set on rollup-style meters (`{mode}:{meter}:{project}:{hour}`).
  /// Null for per-event meters keyed on a row id.
  period_start  DateTime?
  occurred_at   DateTime
  sent_at       DateTime?
  stripe_status String    @default("pending") // pending | sent | failed | dead_letter
  attempt_count Int       @default(0)
  last_error    String?
  payload       Json?

  @@index([stripe_status, occurred_at])
  @@index([project_id, meter_name, period_start])
}

/// Per-project / per-day / per-meter rollup. Powers the `/usage`
/// dashboard, projection math, and reconciliation against Stripe's
/// Meter Event Summary API.
model UsageDaily {
  id              String @id @default(cuid())
  project_id      String
  day             String // YYYY-MM-DD UTC
  meter_name      String
  value           BigInt
  cost_usd_micros BigInt @default(0)

  @@unique([project_id, day, meter_name])
  @@index([project_id, day])
}

/// BYOK token spend per (project, day, model). Display only — never
/// emitted to Stripe. Lets the dashboard surface "you spent $X on your
/// own OpenAI key today" without us being on the hook for the cost.
model BYOKDailySpend {
  id              String @id @default(cuid())
  project_id      String
  day             String
  model           String
  input_tokens    BigInt @default(0)
  output_tokens   BigInt @default(0)
  cost_usd_micros BigInt @default(0)

  @@unique([project_id, day, model])
}

/// Holds a pending storage downsize until the current billing period
/// ends. We schedule on-chain `pool_vault::resize_shrink` to fire at
/// `effective_at` (period boundary); until then the customer keeps the
/// full capacity they paid for, matching Dropbox / iCloud / DO Spaces
/// convention. Cancel-able from the dashboard before fire.
model PendingStorageDowngrade {
  id                      String    @id @default(cuid())
  project_id              String    @unique
  // MiB after the storage_v2 cutover (B5 follow-up — was GB-quantity
  // for storage_v1). Stripe `subscription_item.quantity` matches this
  // exactly because the storage Price's tiers are per-MiB graduated.
  new_reserved_mb         Int
  current_reserved_mb     Int
  effective_at            DateTime
  requested_at            DateTime  @default(now())
  /// Optional Stripe Subscription Schedule id, if we use one.
  stripe_schedule_id      String?
  status                  String    @default("scheduled") // scheduled | applied | cancelled | failed
  applied_at              DateTime?
  resize_shrink_tx_digest String?
  last_error              String?

  @@index([status, effective_at])
}

/// Inbound Stripe webhooks, dedup'd by Stripe `event.id`. The webhook
/// controller writes the row + enqueues; the BullMQ processor consumes
/// and marks `processed_at`. Replays are idempotent because the id is
/// the primary key.
model StripeWebhookEvent {
  id            String    @id // Stripe event.id
  type          String
  received_at   DateTime  @default(now())
  processed_at  DateTime?
  attempt_count Int       @default(0)
  payload       Json
  last_error    String?

  @@index([type, received_at])
}

/// Soft-cap threshold alerts. The soft-alert evaluator writes one row
/// per (project, period, threshold) the first time accrued usage
/// crosses that threshold; the alert-delivery worker drains pending
/// rows to whichever channel the project has configured (email,
/// Slack — both stubbed in B5, real providers in a follow-up).
///
/// Why a table rather than booleans on `BillingAccount`:
///   - audit trail: we want to know "this user got a 50% alert on
///     2026-05-19 14:32, delivered to ops@…";
///   - delivery decoupling: if the email provider is down we retry;
///   - per-channel logging: same threshold can fire on multiple
///     channels (Slack + email) with different outcomes.
///
/// `(project_id, period, threshold_pct, channel)` is unique so we
/// can't fire the same alert twice. Period rollover (new month)
/// produces fresh rows naturally.
model BillingAlert {
  id              String   @id @default(cuid())
  project_id      String
  /// Calendar-month-UTC of the period: YYYY-MM. Matches the
  /// `/v1/usage` window so the dashboard can correlate.
  period          String
  /// 50, 80, 100, etc. Matches values from
  /// `BillingAccount.soft_alert_thresholds`.
  threshold_pct   Int
  /// `email`, `slack`, `log`. Stubbed channels emit to logger; real
  /// ones swap in later.
  channel         String
  /// USD-cents accrued when the alert fired (snapshot for audit).
  accrued_at_fire_usd_cents Int
  /// USD-cents cap the threshold was a percentage of.
  cap_usd_cents             Int
  fired_at        DateTime @default(now())
  delivered_at    DateTime?
  attempt_count   Int      @default(0)
  last_error      String?
  payload         Json?
  @@unique([project_id, period, threshold_pct, channel])
  @@index([delivered_at, fired_at])
  @@index([project_id, period])
}

/// Daily oracle snapshot + per-meter cost-floor. The cost-floor worker
/// writes one row per day at 01:00 UTC; alerts fire if any customer
/// price drops below the floor × (1 + fx_buffer).
model CostFloorSnapshot {
  id                         String   @id @default(cuid())
  day                        String   @unique
  wal_usd_micros             BigInt
  sui_usd_micros             BigInt
  walrus_storage_price_frost BigInt
  walrus_write_price_frost   BigInt
  /// `{meter_name: { raw_cost_usd_micros, fx_buffered, ship_price, headroom_pct }}`.
  /// Stored as JSON so adding a meter doesn't require a migration.
  per_meter_floor_json       Json
  /// Which oracles answered today, with their quoted prices, for audit.
  oracle_sources             Json
  alert_fired                Boolean  @default(false)
  created_at                 DateTime @default(now())
}
